# Copy to .env for local dev: cp .env.example .env

# Postgres (docker-compose service `postgres`)
POSTGRES_USER=opusflow
POSTGRES_PASSWORD=opusflow
POSTGRES_DB=opusflow
# Matches the postgres service above; not yet read by the backend (no
# feature needs persistence yet) — wired up when one does.
DATABASE_URL=postgres://opusflow:opusflow@postgres:5432/opusflow?sslmode=disable

# App
PORT=8080
# Where fetched/extracted artist photos and album covers (TDR 003) are
# cached on disk; matches the docker-compose `artwork` volume mount.
ARTWORK_DIR=/data/artwork
